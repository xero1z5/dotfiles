/*****----- WiFi Password Dialog -----*****/
/* A focused overlay for password entry — no list, no mode switcher         */

@import "~/.config/rofi/shared/fonts.rasi"
@import "~/.config/rofi/colors/matugen.rasi"

/* ── window ─────────────────────────────────────────────────────────────── */
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            480px;
    border:           2px solid;
    border-radius:    24px;
    border-color:     @primary;
    background-color: @surface-container-low;
    padding:          0px;
}

/* ── mainbox: header + inputbar stacked ─────────────────────────────────── */
mainbox {
    spacing:          0px;
    padding:          0px;
    background-color: transparent;
    children:         [ "message", "inputbar" ];
}

/* ── header message (shows network name) ────────────────────────────────── */
message {
    padding:          20px 24px 0px 24px;
    background-color: transparent;
}

textbox {
    background-color: transparent;
    text-color:       @primary;
    font:             "Lexend 15";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          0px;
    border:           0px;
}

/* ── input area ─────────────────────────────────────────────────────────── */
inputbar {
    spacing:          12px;
    padding:          16px 20px;
    margin:           12px 20px 12px 20px;
    border-radius:    14px;
    border:           1px solid;
    border-color:     @outline-variant;
    background-color: @surface-container;
    text-color:       @on-surface;
    children:         [ "textbox-prompt-colon", "entry", "listview" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰌋";
    font:             "JetBrainsMono Nerd Font 16";
    text-color:       @primary;
    background-color: transparent;
    vertical-align:   0.5;
}

entry {
    placeholder:      "Enter password…";
    placeholder-color:@outline;
    text-color:       @on-surface;
    background-color: transparent;
    cursor:           text;
    vertical-align:   0.5;
    expand:           true;
}

/* ── listview (shows the Show/Hide toggle option) ───────────────────────── */
listview {
    layout:           horizontal;
    columns:          1;
    lines:            1;
    scrollbar:        false;
    padding:          0px;
    spacing:          0px;
    background-color: transparent;
    border:           0px;
    expand:           false;
}

element {
    padding:          0px 8px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @on-surface-variant;
    cursor:           pointer;
}

element selected {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 16";
}

element-icon {
    size:             0px;  /* hide icons */
    background-color: transparent;
}

/* ── no mode switcher ────────────────────────────────────────────────────── */
mode-switcher { enabled: false; }
