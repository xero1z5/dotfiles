    "Modular Integer Struct": {
        "prefix": "modint",
        "body": [
            "struct mi{",
            "    int v;",
            "    mi() : v(0){};",
            "    mi(ll _v){",
            "        _v%=mod;",
            "        if(_v<0) _v+=mod;",
            "        v=int(_v);",
            "    }",
            "",
            "    explicit operator int() const { return v; }",
            "",
            "    mi& operator+=(mi b){",
            "        v+=b.v;",
            "        if(v>=mod) v-=mod;",
            "        return *this;",
            "    }",
            "    mi& operator-=(mi b){",
            "        v-=b.v;",
            "        if(v<0) v+=mod;",
            "        return *this;",
            "    }",
            "    mi& operator*=(mi b){",
            "        v=int((1ll*v*b.v)%mod);",
            "        return *this;",
            "    }",
            "    mi& operator/=(mi b){",
            "        return *this *= mi(::inv(b.v));",
            "    }",
            "",
            "    friend mi operator+(mi a, mi b){ return a+=b; }",
            "    friend mi operator-(mi a, mi b){ return a-=b; }",
            "    friend mi operator*(mi a, mi b){ return a*=b; }",
            "    friend mi operator/(mi a, mi b){ return a/=b; }",
            "",
            "    friend mi pow(mi a, ll p){ return mi(::modpow(a.v,p)); }",
            "    friend mi inv(mi a){ return mi(::inv(a.v)); }",
            "};"
        ]
    },
    "Sparse Table Template": {
        "prefix": "rmq",
        "body": [
            "const int N=2e5+5;",
            "const int logN=19;",
            "",
            "int st[N][logN];",
            "void build_sparse(vi& arr){",
            "   int n=arr.size();",
            "   fo(i,0,n){",
            "       st[i][0]=arr[i];",
            "   }",
            "   ",
            "   fo(i,1,logN){",
            "       for(int j=0;j<=n-(1<<i);j++){",
            "           st[j][i]=min(st[j][i-1],st[j+(1<<(i-1))][i-1]);",
            "       }",
            "   }",
            "}",
            "",
            "int rmq(int l,int r){",
            "   int k=log2(r-l+1);",
            "   return min(st[l][k],st[r-(1<<k)+1][k]);",
            "}",
            ""
        ]
    },
    "Segment Tree Template": {
        "prefix": "segtree",
        "body": [
            "template<typename Node, typename Update>",
            "struct SegTree {",
            "    vector<Node> tree;",
            "    vl arr; // -> this may change;",
            "    int n,s;",
            "    SegTree(int alen, vl &a){",
            "        arr=a;n=alen;",
            "        s=1;",
            "        while(s<2*n) s=s<<1;",
            "        tree.resize(s);fill(all(tree),Node());",
            "        build(0,n-1,1);",
            "    }",
            "",
            "    // these never changes",
            "    void build(int start,int end,int id){",
            "        if(start==end){",
            "            tree[id]=Node(arr[start]);",
            "            return;",
            "        }",
            "        int mid=(start+end)/2;",
            "        build(start,mid,2*id);",
            "        build(mid+1,end,2*id+1);",
            "        tree[id].merge(tree[2*id],tree[2*id+1]);",
            "    }",
            "    void make_update(int start, int end, int id,int qid, Update &u){",
            "        if(start==end){",
            "            u.apply(tree[id]);",
            "            return;",
            "        }",
            "        int mid=(start+end)/2;",
            "        if(mid>=qid) make_update(start,mid,2*id,qid,u);",
            "        else make_update(mid+1,end,2*id+1,qid,u);",
            "        tree[id].merge(tree[2*id],tree[2*id+1]);",
            "    }",
            "    ",
            "    Node make_query(int start, int end, int id, int left, int right){",
            "        if(start>right || end<left) return Node();",
            "        if(start>=left && end<=right) return tree[id];",
            "        int mid=(start+end)/2;",
            "        Node l,r,ans;",
            "        l=make_query(start, mid, 2*id, left, right);",
            "        r=make_query(mid+1, end, 2*id+1, left, right);",
            "        ans.merge(l,r);",
            "        return ans;",
            "    }",
            "",
            "    void update(int id, ll val){",
            "        Update new_update=Update(val);",
            "        make_update(0,n-1,1,id,new_update);",
            "    }",
            "    Node query(int left,int right){",
            "        return make_query(0,n-1,1,left,right);",
            "    }",
            "};",
            "",
            "// Definition",
            "struct Node {",
            "    ll val;",
            "    Node() : val(0) {} //identity",
            "    Node(ll v) : val(v) {}",
            "    void merge(Node &l,Node& r){",
            "        $1",
            "    }",
            "};",
            "",
            "struct Update {",
            "    ll val;",
            "    Update(ll v) : val(v) {};",
            "    void apply(Node &a){",
            "        $2",
            "    }",
            "};",
            "",
            "// --------------------------- SegTree Ends----------------------------------",
            "$0"
        ]
    },
    "Fenwick Tree Template": {
        "prefix": "fenwick",
        "body": [
            "struct Fenwick {",
            "    int n; vl bit; //1 indexed",
            "    Fenwick(int n) : n(n), bit(n+1,0){}",
            "",
            "    void update(int id,ll delta){",
            "        for(;id<=n;id+=id&-id) bit[id]+=delta;",
            "    }",
            "",
            "    ll query(int id){",
            "        ll sum=0;",
            "        for(;id>0;id-=id&-id) sum+=bit[id];",
            "        return sum;",
            "    }",
            "",
            "    ll query(int l, int r){",
            "        return query(r)-query(l-1);",
            "    }",
            "",
            "    void assign(int id, ll new_val){",
            "        ll curr=query(id,id);",
            "        ll diff=new_val-curr;",
            "        update(id,diff);",
            "    }",
            "};"
        ]
    },
    "DSU Template": {
        "prefix": "DSU",
        "body": [
            "struct DSU{",
            "    vi p,sz;",
            "    DSU(int n=0){",
            "        reset(n);",
            "    }",
            "    void reset(int n){",
            "        p.resize(n);",
            "        sz.assign(n,1);",
            "        iota(all(p),0); // 0-based indexing",
            "    }",
            "    int find(int x){",
            "        return p[x]==x ? x : p[x] = find(p[x]);",
            "    }",
            "    bool unite(int a, int b){",
            "        a=find(a);",
            "        b=find(b);",
            "        if(a==b) return false;",
            "        if(sz[a]<sz[b]) swap(a,b); // union by size;",
            "        p[b]=a;",
            "        sz[a]+=sz[b];",
            "        return true;",
            "    }",
            "    bool same(int a, int b){",
            "        return find(a)==find(b);",
            "    }",
            "    int size(int x){",
            "        return sz[find(x)];",
            "    }",
            "};"
        ]
    }
